# Local Anvil (`make anvil`, or `anvil` directly) — do not point this at a
# real network without replacing every key below first.
RPC_URL=http://127.0.0.1:8545

# Anvil's default account #0. Well-known local-only test key (mnemonic
# "test test test test test test test test test test test junk") — deploys
# the stack and acts as upgradeAuthority + attestor for the local demo.
# ponytail: one key covers three roles here because a local demo doesn't
# need them separated; a real deployment would use distinct keys/multisig.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Anvil's default account #1. Plays both creator and subscriber for the
# seeded demo agents — one wallet is enough to show every flow.
DEMO_USER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Real Kuru Factory on Monad testnet, verified on-chain (unlike the mainnet
# Router, whose implementation is unverified — see IKuruRouter.sol). Only
# needed for a testnet deploy that registers a real Kuru market instead of
# MockKuruFactory; the local Anvil deploy script does not read this.
KURU_FACTORY_ADDRESS=0x7EFbE105Ca7415dE98F96622173458ac1c054630

# ---------------------------------------------------------------------------
# Jalur bertahap: make deployMock → deployCore → init → (upgradeCore)
# Semua alamat di bawah OPSIONAL: kalau kosong, script membaca key yang sama
# dari DEPLOYMENT_FILE (hasil langkah sebelumnya). Isi hanya untuk menimpa
# dengan kontrak asli di Monad.
# ---------------------------------------------------------------------------

# File alamat bersama. Default deployments/anvil.json (dibaca custos-web dan
# indexer). Untuk Monad testnet pakai file terpisah, mis. deployments/monad-testnet.json.
#DEPLOYMENT_FILE=deployments/anvil.json

# deployCore — accounting asset (D4). Kosong = .usdc dari deployMock.
#USDC_ADDRESS=

# deployCore — NanSigil yang sudah ada (repo nansigil-contract). Kosong = deploy baru di sini,
# dengan ATTESTOR_ADDRESS sebagai signer (kosong = deployer).
#NANSIGIL_ADDRESS=
#ATTESTOR_ADDRESS=

# init — proxy Chainlink MON/USD di Monad (ABI EACAggregatorProxy). Isi dari
# explorer. Kosong = .monUsdFeed (MockAggregator dari deployMock, harga tetap 2 USD).
# WAJIB alamat asli untuk deployment non-demo — mock tidak pernah bergerak.
#MON_USD_FEED=

# init — token MON yang dinilai feed di atas. Kosong = .mon dari deployMock.
#MON_ADDRESS=

# init — umur maksimum jawaban feed (detik) sebelum totalAssets() revert
# StalePrice. Samakan dengan heartbeat feed di explorer + margin. Default 86400.
#FEED_MAX_STALENESS=86400

# init — KuruMarketAdapter yang dicatat sebagai marketAdapter. Kosong = .market.
#MARKET_ADDRESS=

# init — yield source yang di-allowlist (H1). Kosong = .yieldSource (mock);
# kalau keduanya kosong, tidak ada yield source yang diizinkan.
#YIELD_SOURCE=

# init — seed minimum creator dalam USDC utuh (D15). Default 500.
#MIN_SEED_USDC=500

# init — override alamat core kalau tidak dari deployCore di file yang sama.
#CUSTOS_PROXY=
#PRICE_ORACLE=
#VAULT_FACTORY=

